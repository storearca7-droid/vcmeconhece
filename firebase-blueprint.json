{
  "entities": {
    "QuizResult": {
      "title": "Quiz Result",
      "description": "Represents the participation result of a user in the quiz",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the participant"
        },
        "phone": {
          "type": "string",
          "description": "The phone number of the participant"
        },
        "score": {
          "type": "number",
          "description": "The total score achieved"
        },
        "total": {
          "type": "number",
          "description": "The maximum possible score"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The time the result was submitted"
        }
      },
      "required": ["name", "phone", "score", "total", "createdAt"]
    }
  },
  "firestore": {
    "quizResults/{resultId}": {
      "schema": {
        "$ref": "#/entities/QuizResult"
      },
      "description": "Stores all the quiz submissions"
    }
  }
}
